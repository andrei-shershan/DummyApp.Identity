{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FeatureFlags": {
    "DefaultRolesSeed": false,
    "DefaultUsersSeed": false
  },
  "DefaultUsers": [
    {
      "Email": "admin@dummy.localhost",
      "Password": "Admin123!",
      "Role": "Admin",
      "FirstName": "Admin",
      "LastName": "User"
    },
    {
      "Email": "moderator@dummy.localhost",
      "Password": "Moderator123!",
      "Role": "Moderator",
      "FirstName": "Moderator",
      "LastName": "User"
    },
    {
      "Email": "customer@dummy.localhost",
      "Password": "Customer123!",
      "Role": "Customer",
      "FirstName": "Customer",
      "LastName": "User"
    },
    {
      "Email": "creator@dummy.localhost",
      "Password": "Creator123!",
      "Role": "Creator",
      "FirstName": "Creator",
      "LastName": "User"
    }
  ],
  "Database": {
    "UseInMemory": false,
    "ConnectionString": "server=mysql;port=3306;database=dummy_identity;user=dummyapp;password=secret"
  }
  ,
  "ApiUrls": {
    "Identity": "https://identity.dummy.localhost",
    "Bff": "https://bff.dummy.localhost"
  },
  "OpenId": {
    "Issuer": "https://identity.dummy.localhost",
    "Audiences": [ "DummyApp.StorageService" ],
    "Clients": {
      "Bff": {
        "ClientId": "bff-client",
        "ClientSecret": "secret",
        "RedirectUris": "https://bff.dummy.localhost/signin-oidc",
        "PostLogoutRedirectUris": "https://bff.dummy.localhost/signout-callback-oidc"
      },
      "Storage": {
        "ClientId": "storage-client",
        "ClientSecret": "storage-secret",
        "DisplayName": "Storage service client"
      }
    }
  }
}
