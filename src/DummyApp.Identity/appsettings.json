{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FeatureFlags": {
    "DefaultRolesSeed": false,
    "DefaultUsersSeed": false
  },
  "DefaultUsers": [
    {
      "Email": "admin@dummy.localhost",
      "Password": "Admin123!",
      "Role": "Admin",
      "FirstName": "Admin",
      "LastName": "User"
    },
    {
      "Email": "moderator@dummy.localhost",
      "Password": "Moderator123!",
      "Role": "Moderator",
      "FirstName": "Moderator",
      "LastName": "User"
    },
    {
      "Email": "customer@dummy.localhost",
      "Password": "Customer123!",
      "Role": "Customer",
      "FirstName": "Customer",
      "LastName": "User"
    },
    {
      "Email": "creator@dummy.localhost",
      "Password": "Creator123!",
      "Role": "Creator",
      "FirstName": "Creator",
      "LastName": "User"
    }
  ],
  "Infrastructure": {
    "Databases": {
      "Identity": {
        "UseInMemory": false,
        "ConnectionString": "server=mysql;port=3306;database=dummy_identity;user=dummyapp;password=secret"
      }
    }
  },
  "Services": {
    "Identity": {
      "BaseUrl": "https://identity.dummy.localhost"
    },
    "BFF": {
      "BaseUrl": "https://bff.dummy.localhost"
    }
  },
  "IdentityServer": {
    "Authority": "https://identity.dummy.localhost",
    "Audiences": [ "DummyApp.StorageService" ],
    "OidcClients": {
      "BFF": {
        "ClientId": "bff-client",
        "ClientSecret": "secret",
        "RedirectUri": "https://bff.dummy.localhost/signin-oidc",
        "PostLogoutRedirectUri": "https://bff.dummy.localhost/signout-callback-oidc"
      },
      "ApiGateway": {
        "ClientId": "storage-client",
        "ClientSecret": "storage-secret",
        "DisplayName": "Storage service client"
      }
    }
  }
}