@model DummyApp.Identity.Models.RegisterViewModel
<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invitation Registration</title>
    <style>
        body { font-family:Segoe UI,Arial,Helvetica,sans-serif; padding:2rem; background:#f5f5f5; }
        .form { max-width:420px; margin:2rem auto; background:#fff; padding:2rem; border-radius:8px; box-shadow:0 2px 8px rgba(0,0,0,.1); }
        h2 { margin-top:0; }
        label { display:block; margin-top:1rem; font-weight:600; }
        input[type=email], input[type=password] { width:100%; padding:0.5rem; margin-top:0.25rem; box-sizing:border-box; border:1px solid #ccc; border-radius:4px; font-size:1rem; }
        .error { color:#c00; font-size:0.875rem; margin-top:0.25rem; display:block; }
        .error-summary { background:#fff0f0; border:1px solid #fcc; border-radius:4px; padding:0.75rem; margin-bottom:1rem; color:#c00; }
        button { margin-top:1.5rem; width:100%; padding:0.65rem; font-size:1rem; border-radius:4px; border:none; background:#0078d4; color:#fff; cursor:pointer; }
        button:hover { background:#005a9e; }
    </style>
</head>
<body>
    <div class="form">
        <h2>Invitation Registration</h2>

        @if (!Model.InviteValid)
        {
            <div class="error-summary">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }
        else if (!ViewData.ModelState.IsValid)
        {
            <div class="error-summary">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form method="post" action="/account/register">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="ReturnUrl" />

            <label asp-for="Email">Email</label>
            <input asp-for="Email" type="email" autocomplete="username" />
            <span class="error" asp-validation-for="Email"></span>

            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" autocomplete="new-password" />
            <span class="error" asp-validation-for="Password"></span>

            <label asp-for="ConfirmPassword">Confirm password</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
            <span class="error" asp-validation-for="ConfirmPassword"></span>

            <button type="submit">Register</button>
        </form>
    </div>
</body>
</html>
