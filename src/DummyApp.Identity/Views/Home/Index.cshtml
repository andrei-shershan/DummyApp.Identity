@{
    var isAuth = User?.Identity?.IsAuthenticated ?? false;
}
<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DummyApp Identity</title>
</head>
<body>
    <h1>DummyApp Identity Server</h1>
    @if (isAuth)
    {
        <p>Signed in as <strong>@User.Identity.Name</strong></p>
        <p><a href="/account/logout">Sign out</a></p>
    }
    else
    {
        <p>You are not signed in.</p>
        <p><a href="/account/login">Sign in</a></p>
    }
</body>
</html>