{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Infrastructure": {
    "Databases": {
      "Identity": {
        "UseInMemory": false,
        "ConnectionString": "server=mysql;port=3306;database=dummy_identity;user=dummyapp;password=secret"
      }
    }
  },
  "Services": {
    "Identity": {
      "BaseUrl": "https://identity.dummy.localhost"
    },
    "BFF": {
      "BaseUrl": "https://bff.dummy.localhost"
    }
  },
  "IdentityServer": {
    "Authority": "https://identity.dummy.localhost",
    "Audiences": [ "DummyApp.StorageService" ],
    "OidcClients": {
      "BFF": {
        "ClientId": "bff-client",
        "ClientSecret": "secret",
        "RedirectUri": "https://bff.dummy.localhost/signin-oidc",
        "PostLogoutRedirectUri": "https://bff.dummy.localhost/signout-callback-oidc"
      },
      "ApiGateway": {
        "ClientId": "storage-client",
        "ClientSecret": "storage-secret",
        "DisplayName": "Storage service client"
      }
    }
  }
}